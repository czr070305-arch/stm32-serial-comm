# ============================================================
# Keil MDK 编译中间产物与用户配置
# ============================================================

# 编译输出目录（若工程按默认结构生成）
Objects/
Listings/

# 编译中间文件
*.o
*.d
*.crf
*.dep
*.lnp
*.axf
*.sct
*.map
*.lst
*.htm
*.hex
*.bin

# Keil 用户个人配置（含窗口布局、用户名，不该提交）
*.uvguix.*
*.uvoptx

# 编译日志与备份
build_log.txt
*.bak
*.bak_*
*.scvd

# VSCode / Keil Assistant 插件缓存
.vscode/

# ============================================================
# CubeMX
# ============================================================
# .mxproject 是 CubeMX 生成的缓存，源文件 01_Project.ioc 才是唯一配置依据
.mxproject

# ============================================================
# 通用
# ============================================================
*.tmp
*.log
Thumbs.db
Desktop.ini
